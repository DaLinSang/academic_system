# ============================================================
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，
# 任何时候都不要提交真实 key。
#   cp .env.example .env
# ============================================================

# ---------- LLM 提供方 ----------
# 当前默认走 DeepSeek（OpenAI-compatible）。
# 拿到港大 API key 后，只需改下面 LLM_PROVIDER / BASE_URL / MODEL，代码不用动。
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 港大 ITS GenAI API（拿到配额后启用）
# https://its.hku.hk/services/ai-as-a-service/hku-chatgpt/
HKU_API_KEY=
HKU_BASE_URL=
HKU_MODEL=

# ---------- Embedding ----------
# 本地 Ollama，模型已就绪：nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---------- 数据库（pgvector）----------
# 由 docker compose up -d 启动，端口 5434，与其它项目隔离
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=academic
POSTGRES_USER=academic
POSTGRES_PASSWORD=academic_dev_pw

# ---------- 运行参数 ----------
# 默认会话/用户标识，UI 接入后可覆盖
DEFAULT_SESSION_ID=dev-session
DEFAULT_USER_ID=dev-user

# 日志与实验输出目录
LOG_DIR=logs
RUNS_DIR=runs

# 单次 LLM 调用超时（秒）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

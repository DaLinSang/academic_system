# ============================================================
# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，
# 任何时候都不要提交真实 key。
#   cp .env.example .env
# ============================================================

# ---------- LLM 提供方 ----------
# 可选 deepseek / hku。每位成员只改自己的 .env，不需要改代码。
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 港大 Student GenAI API（订阅 Active 后启用）
# HKU 使用 api-key Header；客户端会在 LLM_PROVIDER=hku 时自动添加。
HKU_API_KEY=
HKU_BASE_URL=https://api.hku.hk/foundry/student/models
HKU_MODEL=DeepSeek-V3.2

# ---------- Embedding ----------
# 本地 Ollama，模型已就绪：nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---------- 数据库（pgvector）----------
# 由 docker compose up -d 启动，端口 5434，与其它项目隔离
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=academic
POSTGRES_USER=academic
POSTGRES_PASSWORD=academic_dev_pw

# ---------- 运行参数 ----------
# 默认会话/用户标识，UI 接入后可覆盖
DEFAULT_SESSION_ID=dev-session
DEFAULT_USER_ID=dev-user

# 日志与实验输出目录
LOG_DIR=logs
RUNS_DIR=runs

# 单次 LLM 调用超时（秒）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- 联网搜索后端（Issue #89）----------
# 留空则回退到 DDG/Bing HTML 爬取；填入 Tavily key 走稳定 API（免费 1000 次/月）。
# 在 https://app.tavily.com 注册获取。key 只放本地 .env，绝不提交。
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT=40
TAVILY_DEPTH=basic

# 方案 §7：默认停用 DDG/Bing HTML 抓取，只用 Tavily API。
# 仅调试/A-B 对比时设为 1 才启用旧 HTML 后端。
ALLOW_HTML_SEARCH=0
